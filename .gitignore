# .NET build output and local IDE state
**/bin/
**/obj/
/artifacts/
/dist/
/dev-tests/artifacts-*/
.vs/
.idea/
*.user
*.rsuser
*.suo
*.userosscache
*.sln.docstates

# Dictionary files are not included in the source repository
*.[mM][dD][xX]
*.[mM][dD][dD]
# EXE-side user configuration is local, including copies used during development
dictionaries.json

# WebView2 profiles, generated test logs and screenshots
**/*.WebView2/
**/EBWebView/
**/TestResults/
/dev-tests/*-results.txt
/dev-tests/screenshots/
*.trx
*.log
*.dmp
coverage/
coverage.xml

# Temporary and OS files; legitimate source images/HTML are not ignored
*.tmp
*.bak
*.orig
*.rej
*~
*.swp
*.swo
Thumbs.db
Desktop.ini
.DS_Store
# Local Python cache if development tooling is used
__pycache__/
*.py[cod]
