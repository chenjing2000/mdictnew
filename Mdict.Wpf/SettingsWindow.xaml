<Window x:Class="Mdict.Wpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="词典设置" Width="450" Height="320" MinWidth="420" MinHeight="300"
        Icon="/MdictViewer;component/Assets/App.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F6F7F9"
        FontSize="14" Foreground="#25303C" UseLayoutRounding="True" PreviewKeyDown="SettingsWindow_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <SolidColorBrush x:Key="IconForeground" Color="#ba5b49" />
        <Pen x:Key="SymbolPen" Brush="{StaticResource IconForeground}" Thickness="3"
             StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
        <DrawingImage x:Key="BrowseIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M 0,0 L 24,0 24,24 0,24 Z" />
                    <GeometryDrawing Pen="{StaticResource SymbolPen}"
                        Geometry="M 3,18 L 3,6 9,6 11,9 20,9 20,11 M 3,18 L 6,11 21,11 18,19 3,19 Z" />
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="MoveUpIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M 0,0 L 24,0 24,24 0,24 Z" />
                    <GeometryDrawing Pen="{StaticResource SymbolPen}" Geometry="M 6,14 L 12,8 18,14" />
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="MoveDownIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M 0,0 L 24,0 24,24 0,24 Z" />
                    <GeometryDrawing Pen="{StaticResource SymbolPen}" Geometry="M 6,10 L 12,16 18,10" />
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="RemoveIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M 0,0 L 24,0 24,24 0,24 Z" />
                    <GeometryDrawing Pen="{StaticResource SymbolPen}" Geometry="M 6,12 L 18,12" />
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Background" Value="#f5f2e9" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="6"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#ede8dd" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#e4ded1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#3271ae" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsIconButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Resources>
    <Grid Margin="10,20,10,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="词典列表" FontWeight="SemiBold" Margin="0,0,0,10" />
        <Border Grid.Row="1" CornerRadius="6" Background="White" BorderBrush="#C6CBD2" BorderThickness="1">
            <ListBox x:Name="DictionaryList" SelectionMode="Single" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionChanged="DictionaryList_SelectionChanged" AutomationProperties.Name="词典列表">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
            <Button x:Name="BrowseButton" Style="{StaticResource SettingsIconButton}" ToolTip="选择词典文件"
                    AutomationProperties.Name="选择词典文件" Click="BrowseButton_Click">
                <Image Source="{StaticResource BrowseIcon}" Width="19.2" Height="19.2" />
            </Button>
            <Button x:Name="MoveUpButton" Style="{StaticResource SettingsIconButton}" Margin="6,0,0,0"
                    ToolTip="上移" AutomationProperties.Name="上移" Click="MoveUpButton_Click">
                <Image Source="{StaticResource MoveUpIcon}" Width="19.2" Height="19.2" />
            </Button>
            <Button x:Name="MoveDownButton" Style="{StaticResource SettingsIconButton}" Margin="6,0,0,0"
                    ToolTip="下移" AutomationProperties.Name="下移" Click="MoveDownButton_Click">
                <Image Source="{StaticResource MoveDownIcon}" Width="19.2" Height="19.2" />
            </Button>
            <Button x:Name="RemoveButton" Style="{StaticResource SettingsIconButton}" Margin="6,0,0,0"
                    ToolTip="删除词典" AutomationProperties.Name="删除词典" Click="RemoveButton_Click">
                <Image Source="{StaticResource RemoveIcon}" Width="19.2" Height="19.2" />
            </Button>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Grid.Row="3" Foreground="#ba5b49" TextWrapping="Wrap" Margin="0,6,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</Window>
