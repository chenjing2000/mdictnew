<Window x:Class="Mdict.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MdictViewer v0.6.0" Height="750" Width="1100"
        Icon="/MdictViewer;component/Assets/App.ico"
        MinHeight="450" MinWidth="620" WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_Loaded" Closed="MainWindow_Closed"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        PreviewMouseDown="MainWindow_PreviewMouseDown"
        Deactivated="MainWindow_Deactivated">
    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="#f5f2e9" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="#F6F7F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="16,14,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="WordText" FontSize="16" Padding="10,7" Height="40"
                     VerticalContentAlignment="Center"
                     PreviewKeyDown="WordText_PreviewKeyDown" TextChanged="WordText_TextChanged"
                     LostKeyboardFocus="WordText_LostKeyboardFocus" SizeChanged="WordText_SizeChanged" />
            <Button x:Name="BackButton" Grid.Column="1" Style="{StaticResource ToolbarButton}"
                    ToolTip="后退" IsEnabled="False" Click="BackButton_Click" AutomationProperties.Name="后退">
                <Path Data="M 8,0 L 0,8 L 8,16" Stroke="#ba5b49" StrokeThickness="2.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Button>
            <Button x:Name="ForwardButton" Grid.Column="2" Style="{StaticResource ToolbarButton}"
                    ToolTip="前进" IsEnabled="False" Click="ForwardButton_Click" AutomationProperties.Name="前进">
                <Path Data="M 0,0 L 8,8 L 0,16" Stroke="#ba5b49" StrokeThickness="2.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Button>
            <Button x:Name="SettingsButton" Grid.Column="3" Style="{StaticResource ToolbarButton}"
                    ToolTip="词典设置" Click="SettingsButton_Click" AutomationProperties.Name="词典设置">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.8" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#3271ae" />
            </Button>
            <Popup x:Name="SuggestionPopup" PlacementTarget="{Binding ElementName=WordText}"
                   Placement="Bottom" VerticalOffset="2" StaysOpen="True" AllowsTransparency="True"
                   Focusable="False" IsOpen="False">
                <Border x:Name="SuggestionBorder" Background="White" BorderBrush="#CCD3DD"
                        BorderThickness="1" CornerRadius="4" Padding="2" SnapsToDevicePixels="True">
                    <ListBox x:Name="SuggestionList" MaxHeight="300" Focusable="False" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PreviewMouseLeftButtonDown="SuggestionList_PreviewMouseLeftButtonDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Padding" Value="9,5" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>
            </Popup>
        </Grid>
        <ScrollViewer x:Name="ResultsScroll" Grid.Row="1" Margin="16,0,16,0" Background="White"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
            <StackPanel x:Name="ResultsPanel">
                <TextBlock x:Name="EmptyText" Text="尚未设置词典" Margin="16,24" Foreground="#626973" />
            </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="2" x:Name="StatusText" Margin="16,10,16,12" FontSize="12"
                   Text="正在初始化…" Foreground="#515965" TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
