<Window x:Class="Mdict.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MdictViewer v0.4.0" Height="750" Width="1100"
        MinHeight="450" MinWidth="620"
        WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_Loaded" Closed="MainWindow_Closed"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Grid Background="#F6F7F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="16,14,16,10" LastChildFill="True">
            <Button x:Name="OpenButton" Content="打开词典…"
                    Width="104" Height="34" DockPanel.Dock="Right"
                    Margin="12,0,0,0" Click="OpenButton_Click" />
            <StackPanel>
                <TextBlock Text="Oxford Dictionary" FontSize="19"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="DictionaryText" Text="尚未打开词典"
                           FontSize="12" Foreground="#626973"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="16,0,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="86" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Content="←" ToolTip="返回上一词条"
                    FontSize="18" IsEnabled="False" Click="BackButton_Click"
                    Margin="0,0,7,0" />
            <TextBox Grid.Column="1" x:Name="WordText" Text="apple" FontSize="16"
                     Padding="10,7" Height="40" VerticalContentAlignment="Center"
                     KeyDown="WordText_KeyDown" />
            <Button x:Name="SearchButton" Content="查词" Grid.Column="2"
                    Margin="9,0,0,0" IsEnabled="False"
                    Click="SearchButton_Click" />
        </Grid>

        <Border Grid.Row="2" Margin="16,0,16,0" Background="White"
                BorderBrush="#E0E4E8" BorderThickness="1" CornerRadius="5">
            <wv2:WebView2 x:Name="DictionaryWebView" />
        </Border>

        <TextBlock Grid.Row="3" x:Name="StatusText" Margin="16,10,16,12"
                   Text="正在初始化 WebView2…" FontSize="12"
                   Foreground="#515965" TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
